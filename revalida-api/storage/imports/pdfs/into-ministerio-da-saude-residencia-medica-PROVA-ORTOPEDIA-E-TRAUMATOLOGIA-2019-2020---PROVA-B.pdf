									  <script type="text/javascript">
    function clrbusca(a){
        if((a=="Busca no site")){
            document.getElementById("itBusca").value="";
            }
         if ((a=="Nº prontuário")){
            document.getElementById("pront").value="";
            }
            return true
    }
                   
                  
         function buscaFila(event) {
            if (event.keyCode == 13) {
                pesquisa()
                return false; 
            }  
            else
                return true;
         }
         
            function pesquisa(){
            if ((document.getElementById('pront').value.replace(/ /g,'') != "") && (isNaN(document.getElementById('pront').value) == false)){
             window.open('https://sistemas.into.saude.gov.br/internet/fila/resultado.aspx?p=' + document.getElementById('pront').value, '_self');
            }
            else{
            alert('Digite um número de prontuário válido');
            document.getElementById('pront').select();
            }
            }            
            
        </script>
	

	   <div id="dvFila"  style="display: inline-flex;" >
                <table>               
                <tr><td width="550px">
	        <strong>Lista de espera para cirurgia</strong> <input type="text" placeholder="Digite o nº do prontuário" class="input-small" size="100" onkeypress="return buscaFila(event);" onfocus="clrbusca(this.value);" id="pront" style="width: 156px; vertical-align:baseline !important;"  /> <a href="javascript:pesquisa()" ><button id="singlebutton" name="singlebutton" class="btn btn-primary">Buscar</button></a> 
                </td>
               <td><a href="/como-ser-atendido-no-into" ><button id="singlebutton" name="singlebutton" class="btn btn-primary">Como ser Atendido no Into</button></a> </td> 
               </tr>
               </table>


